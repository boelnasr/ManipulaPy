# Include the README and license files
include README.md
include LICENSE.md
include CHANGELOG.md
include CODE_OF_CONDUCT.md

# Include all Python files in the main package
recursive-include ManipulaPy *.py

# Include URDF files only (NOT mesh files - too large for PyPI)
recursive-include ManipulaPy/ManipulaPy_data *.urdf
recursive-include ManipulaPy/ManipulaPy_data *.md
recursive-include ManipulaPy/ManipulaPy_data *.yaml

# Include configuration files.
#
# These are named explicitly rather than globbed. The sdist is built from the
# WORKING TREE, not from git, so a recursive glob over ManipulaPy/ sweeps up
# any untracked or gitignored file that happens to match — a root .gitignore
# entry does not protect paths nested under the package. A broad
# "*.yaml *.json *.xml *.cfg *.ini" glob here previously shipped a local
# developer tool config to PyPI; anything matching that pattern is a direct,
# silent path from a developer's disk into a published artifact.
include ManipulaPy/urdf/package_map.example.json

# Include tests
recursive-include tests *.py

# ============================================================
# EXCLUDE large files to keep package under PyPI size limits
# ============================================================

# Exclude mesh files (users can download separately if needed)
global-exclude *.stl
global-exclude *.dae
global-exclude *.obj
global-exclude *.mesh

# Exclude _source directory (xacro development files)
recursive-exclude ManipulaPy/ManipulaPy_data/_source *

# Exclude unwanted files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *~
global-exclude *.tmp
global-exclude .DS_Store
global-exclude __pycache__
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

# Defence in depth: never ship developer tool configuration or local
# overrides that happen to sit under the package tree, whatever the includes
# above may match in future.
global-exclude *.local.json
prune ManipulaPy/ManipulaPy_data/.claude

# Exclude development files
exclude .gitignore
exclude .pre-commit-config.yaml
exclude tox.ini
exclude .travis.yml
exclude .github

# Exclude docs and examples from package (available on GitHub)
recursive-exclude docs *
recursive-exclude Examples *
recursive-exclude Benchmark *
